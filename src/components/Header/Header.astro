---
import ThemeSwitch from '../ThemeSwitch/ThemeSwitch.astro';
import NavLink from './NavLink.astro';
---

<style lang='scss'>
	$breakpoint: 600px;

	.root {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		position: fixed;
		height: 60px;
		top: 0;
		padding: 0 1rem;

		background-color: var(--bg-color-to);
		box-shadow: 0px 0px 8px 1px rgba(0, 0, 0, 0.1);
		z-index: 1;
	}

	.name {
		font-size: 1.25rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--text-color);
	}
</style>
<header id='header' class='root'>
	<a class='name' href='/'>Isaiah's Blog</a>
	<ThemeSwitch transition:persist />
</header>
